<< /A << /JS (// "RESET FORM" BUTTON: asks first, then sets every answer back to how the form started, and re-checks.\nif \(app.alert\("Are you sure you want to reset the form? All your answers will be cleared.", 2, 2\) == 4\) {\nthis.resetForm\(["DBRP"]\); if \(typeof lcDrawQr_DBRP == "function"\) lcDrawQr_DBRP\(this, ""\); if \(typeof lcDates_DBRP == "function"\) lcDates_DBRP\(this\); if \(typeof lcRules_DBRP == "function"\) lcRules_DBRP\(this\); }) /S /JavaScript >> /AP << /D 14622 0 R /N 14622 0 R >> /BS << /W 0 >> /F 0 /MK << /BC [ 0 0 0 ] /BG [ 0 0 0 ] /CA (Reset form) >> /P 90 0 R /Parent 3464 0 R /Rect [ 489.28 816.89 553.28 829.89 ] /Subtype /Widget /Type /Annot >>
