<< /A << /JS (// "RESET FORM" BUTTON: asks first, then sets every answer back to how the form started, and re-checks.\nif \(app.alert\("Are you sure you want to reset the form? All your answers will be cleared.", 2, 2\) == 4\) {\nthis.resetForm\(["EBLC"]\); if \(typeof lcDrawQr_EBLC == "function"\) lcDrawQr_EBLC\(this, ""\); if \(typeof lcDates_EBLC == "function"\) lcDates_EBLC\(this\); if \(typeof lcRules_EBLC == "function"\) lcRules_EBLC\(this\); }) /S /JavaScript >> /AP << /D 12510 0 R /N 12510 0 R >> /BS << /W 0 >> /F 0 /MK << /BC [ 0 0 0 ] /BG [ 0 0 0 ] /CA (Reset form) >> /P 72 0 R /Parent 1435 0 R /Rect [ 489.28 816.89 553.28 829.89 ] /Subtype /Widget /Type /Annot >>
