<< /A << /JS (// "RESET FORM" BUTTON: asks first, then sets every answer back to how the form started, and re-checks.\nif \(app.alert\("Are you sure you want to reset the form? All your answers will be cleared.", 2, 2\) == 4\) {\nthis.resetForm\(["BEOBC"]\); if \(typeof lcDrawQr_BEOBC == "function"\) lcDrawQr_BEOBC\(this, ""\); if \(typeof lcDates_BEOBC == "function"\) lcDates_BEOBC\(this\); if \(typeof lcRules_BEOBC == "function"\) lcRules_BEOBC\(this\); }) /S /JavaScript >> /AP << /D 14130 0 R /N 14130 0 R >> /BS << /W 0 >> /F 0 /MK << /BC [ 0 0 0 ] /BG [ 0 0 0 ] /CA (Reset form) >> /P 80 0 R /Parent 2637 0 R /Rect [ 489.28 816.89 553.28 829.89 ] /Subtype /Widget /Type /Annot >>
endobj
