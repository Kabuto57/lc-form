<< /A << /JS (// "CHECK FORM" BUTTON: lists what is missing or wrong \(at most 15 of each\) and puts the cursor on the first\n// problem; otherwise says the form is ready.\nif \(typeof lcRules_OBC != "function"\) app.alert\("The form's checks did not start, so nothing has been checked yet. Open the form in Adobe Acrobat or Acrobat Reader and allow JavaScript \(the yellow bar's Options, or Preferences > JavaScript > Enable Acrobat JavaScript\), then close and reopen the form. If it still happens, the form was built from damaged files: build it again.", 1\);\nelse {\nvar m = lcRules_OBC\(this\), b = m.bad || [], t = [];\nvar list = function \(a\) { return "- " + a.slice\(0, 15\).join\("\\n- "\) + \(a.length > 15 ? "\\n- ... and " + \(a.length - 15\) + " more" : ""\); }\nif \(m.length\) t.push\(m.length + " mandatory question" + \(m.length > 1 ? "s are" : " is"\) + " still blank:\\n" + list\(m\)\);\nif \(b.length\) t.push\(b.length + " answer" + \(b.length > 1 ? "s need" : " needs"\) + " correcting:\\n" + list\(b\)\);\nif \(t.length\) { app.alert\("This form is not ready to send. The boxes concerned are outlined in red.\\n\\n" + t.join\("\\n\\n"\) + "\\n\\nPlease correct them before you send the form.", 1\);\n  var g = m.first && this.getField\("OBC." + m.first\); if \(g\) g.setFocus\(\); }\nelse app.alert\("All mandatory questions are answered and every answer is in the right format. You can save the form and send it.", 3\);\n}) /S /JavaScript >> /AP << /D 13416 0 R /N 13416 0 R >> /BS << /W 0 >> /F 0 /MK << /BC [ 0 0 0 ] /BG [ 0 0 0 ] /CA (Check form) >> /P 82 0 R /Parent 2264 0 R /Rect [ 421.28 816.89 485.28 829.89 ] /Subtype /Widget /Type /Annot >>
endobj
7435 0 obj
<< /A << /JS (// "RESET FORM" BUTTON: asks first, then sets every answer back to how the form started, and re-checks.\nif \(app.alert\("Are you sure you want to reset the form? All your answers will be cleared.", 2, 2\) == 4\) {\nthis.resetForm\(["OBC"]\); if \(typeof lcDrawQr_OBC == "function"\) lcDrawQr_OBC\(this, ""\); if \(typeof lcDates_OBC == "function"\) lcDates_OBC\(this\); if \(typeof lcRules_OBC == "function"\) lcRules_OBC\(this\); }) /S /JavaScript >> /AP << /D 13417 0 R /N 13417 0 R >> /BS << /W 0 >> /F 0 /MK << /BC [ 0 0 0 ] /BG [ 0 0 0 ] /CA (Reset form) >> /P 82 0 R /Parent 2265 0 R /Rect [ 489.28 816.89 553.28 829.89 ] /Subtype /Widget /Type /Annot >>
endobj
