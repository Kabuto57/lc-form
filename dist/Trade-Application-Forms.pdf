<< /A << /JS (// "CHECK FORM" BUTTON: lists what is missing or wrong \(at most 15 of each\) and puts the cursor on the first\n// problem; otherwise says the form is ready.\nif \(typeof lcRules_LC != "function"\) app.alert\("The form's checks did not start, so nothing has been checked yet. Open the form in Adobe Acrobat or Acrobat Reader and allow JavaScript \(the yellow bar's Options, or Preferences > JavaScript > Enable Acrobat JavaScript\), then close and reopen the form. If it still happens, the form was built from damaged files: build it again.", 1\);\nelse {\nvar m = lcRules_LC\(this\), b = m.bad || [], t = [];\nvar list = function \(a\) { return "- " + a.slice\(0, 15\).join\("\\n- "\) + \(a.length > 15 ? "\\n- ... and " + \(a.length - 15\) + " more" : ""\); }\nif \(m.length\) t.push\(m.length + " mandatory question" + \(m.length > 1 ? "s are" : " is"\) + " still blank:\\n" + list\(m\)\);\nif \(b.length\) t.push\(b.length + " answer" + \(b.length > 1 ? "s need" : " needs"\) + " correcting:\\n" + list\(b\)\);\nif \(t.length\) { app.alert\("This form is not ready to send. The boxes concerned are outlined in red.\\n\\n" + t.join\("\\n\\n"\) + "\\n\\nPlease correct them before you send the form.", 1\);\n  var g = m.first && this.getField\("LC." + m.first\); if \(g\) g.setFocus\(\); }\nelse app.alert\("All mandatory questions are answered and every answer is in the right format. You can save the form and send it.", 3\);\n}) /S /JavaScript >> /AP << /D 11867 0 R /N 11867 0 R >> /BS << /W 0 >> /F 0 /MK << /BC [ 0 0 0 ] /BG [ 0 0 0 ] /CA (Check form) >> /P 66 0 R /Parent 586 0 R /Rect [ 421.28 816.89 485.28 829.89 ] /Subtype /Widget /Type /Annot >>
endobj
6021 0 obj
<< /A << /JS (// "RESET FORM" BUTTON: asks first, then sets every answer back to how the form started, and re-checks.\nif \(app.alert\("Are you sure you want to reset the form? All your answers will be cleared.", 2, 2\) == 4\) {\nthis.resetForm\(["LC"]\); if \(typeof lcDrawQr_LC == "function"\) lcDrawQr_LC\(this, ""\); if \(typeof lcDates_LC == "function"\) lcDates_LC\(this\); if \(typeof lcRules_LC == "function"\) lcRules_LC\(this\); }) /S /JavaScript >> /AP << /D 11868 0 R /N 11868 0 R >> /BS << /W 0 >> /F 0 /MK << /BC [ 0 0 0 ] /BG [ 0 0 0 ] /CA (Reset form) >> /P 66 0 R /Parent 587 0 R /Rect [ 489.28 816.89 553.28 829.89 ] /Subtype /Widget /Type /Annot >>
endobj
6022 0 obj
<< /A << /JS (// "GENERATE QR CODE" BUTTON: refuses while anything is missing or wrong; otherwise makes the QR code from the\n// answers \(lcPayload_LC, lcDrawQr_LC\), or two codes if the answers don't fit in one, and goes to the QR code page.\nif \(typeof lcRules_LC != "function"\) app.alert\("The form's checks did not start, so nothing has been checked yet. Open the form in Adobe Acrobat or Acrobat Reader and allow JavaScript \(the yellow bar's Options, or Preferences > JavaScript > Enable Acrobat JavaScript\), then close and reopen the form. If it still happens, the form was built from damaged files: build it again.", 1\);\nelse {\nvar m = lcRules_LC\(this\), b = m.bad || [], t = [];\nvar list = function \(a\) { return "- " + a.slice\(0, 15\).join\("\\n- "\) + \(a.length > 15 ? "\\n- ... and " + \(a.length - 15\) + " more" : ""\); }\nif \(m.length\) t.push\(m.length + " mandatory question" + \(m.length > 1 ? "s are" : " is"\) + " still blank:\\n" + list\(m\)\);\nif \(b.length\) t.push\(b.length + " answer" + \(b.length > 1 ? "s need" : " needs"\) + " correcting:\\n" + list\(b\)\);\nif \(t.length\) { app.alert\("The QR code cannot be generated yet. The boxes concerned are outlined in red.\\n\\n" + t.join\("\\n\\n"\) + "\\n\\nPlease correct them, then press Generate QR Code again.", 1\);\n  var g = m.first && this.getField\("LC." + m.first\); if \(g\) g.setFocus\(\); }\nelse { try { var q = this.getField\("LC." + "__qr"\); q.value = lcPayload_LC\(this\); var n = lcDrawQr_LC\(this, q.value\); this.pageNum = 4;\n  if \(n == 1\) app.alert\("The QR code has been generated from your answers \(" + q.value.length + " characters\). Press Print Form to print the form with the QR code.", 3\);\n  else app.alert\("Your answers \(" + q.value.length + " characters\) are too long for one QR code, so two codes have been generated, one under the other. The Bank scans both. Press Print Form to print the form with the QR codes.", 3\); }\n  catch \(e\) { app.alert\("The QR code could not be generated: " + e + "\\nPlease send this message to the form's maintainer.", 1\); } }\n}) /S /JavaScript >> /AP << /D 11869 0 R /N 11869 0 R >> /BS << /W 0 >> /F 0 /MK << /BC [ 0 0 0 ] /BG [ 0 0 0 ] /CA (Generate QR Code) >> /P 66 0 R /Parent 588 0 R /Rect [ 141.64 381.89 291.64 403.89 ] /Subtype /Widget /Type /Annot >>
endobj
6023 0 obj
<< /A << /JS (// "PRINT FORM" BUTTON: prints only once the QR code exists and still matches the current answers, so the\n// printed code always carries the answers on the paper.\nvar q = this.getField\("LC." + "__qr"\), now = typeof lcPayload_LC == "function" ? lcPayload_LC\(this\) : "", same = false;\ntry { same = JSON.stringify\(JSON.parse\(q.value\).data\) == JSON.stringify\(JSON.parse\(now\).data\); } catch \(e\) {}\nif \(!/\\S/.test\(q.value\)\) app.alert\("Please press Generate QR Code first, so the printed form carries the QR code.", 1\);\nelse if \(!same\) app.alert\("Your answers have changed since the QR code was generated. Please press Generate QR Code again, then Print Form.", 1\);\nelse this.print\(true, 1, 4, false, true\);) /S /JavaScript >> /AP << /D 11870 0 R /N 11870 0 R >> /BS << /W 0 >> /F 0 /MK << /BC [ 0 0 0 ] /BG [ 0 0 0 ] /CA (Print Form) >> /P 66 0 R /Parent 589 0 R /Rect [ 303.64 381.89 453.64 403.89 ] /Subtype /Widget /Type /Annot >>
endobj
